# Supabase project settings. Use the anon/publishable key in NEXT_PUBLIC_* only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Browser Use Cloud API v3 (server-side only)
BROWSER_USE_API_KEY=your-browser-use-cloud-key
BROWSER_USE_BASE_URL=https://api.browser-use.com/api/v3
BROWSER_USE_MAX_COST_USD=2

# Optional Base44 adapter. BASE44_AGENT_URL should be a trusted server-side
# endpoint/webhook you control; the Base44 public SDK does not expose a generic
# REST invoke URL for browser-based calls. Requests receive agent_id, message,
# and conversation_id JSON fields with this key as a Bearer token.
BASE44_API_KEY=your-base44-api-key
BASE44_AGENT_ID=your-agent-id
BASE44_BASE_URL=https://app.base44.com/api
BASE44_AGENT_URL=
NEXT_PUBLIC_BASE44_APP_ID=your-base44-app-id
NEXT_PUBLIC_BASE44_AGENT_NAME=your-agent-name

# Optional private evaluation webhook. If omitted, local quality checks are used.
AGENT_EVALUATOR_URL=
AGENT_EVALUATOR_API_KEY=

# Optional Microsoft Playwright CLI runner, available only on a trusted server.
PLAYWRIGHT_CLI_ENABLED=false
PLAYWRIGHT_CLI_BIN=playwright-cli
PLAYWRIGHT_CLI_TIMEOUT_MS=90000

# Optional app-origin override used for auth callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
